# Port Configuration
PORT=3001

# Environment Mode
NODE_ENV=production

# CORS Origins (comma-separated, no spaces)
ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:3000

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here

# Puppeteer Cache (for serverless environments)
PUPPETEER_CACHE_DIR=/tmp/puppeteer

# Google Analytics (Replace with your actual ID)
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# API URL (Optional - for custom backend URL)
REACT_APP_API_URL=

# Frontend Sentry (Optional)
REACT_APP_SENTRY_DSN=your_react_sentry_dsn_here
