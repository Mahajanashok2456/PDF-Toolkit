{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install --production=false",
  "rewrites": [
    { "source": "/api/pdf-to-word", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 30,
      "includeFiles": "server-src/**"
    },
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production",
    "CI": "false"
  }
}