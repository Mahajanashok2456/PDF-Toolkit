{
  "version": 2,
  "rewrites": [
    { "source": "/api/pdf-to-word", "destination": "/api/pytest.py" },
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.js": { "maxDuration": 30 },
    "api/pytest.py": { "maxDuration": 60 }
  },
  "env": {
    "NODE_ENV": "production"
  }
}