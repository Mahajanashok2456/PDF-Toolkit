{
  "rewrites": [
    { "source": "/api/pdf-to-word", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/server.js" }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 30,
      "includeFiles": "server-src/**",
      "excludeFiles": [
        "node_modules/@sparticuz/chromium/**",
        "node_modules/puppeteer/**",
        "node_modules/puppeteer-core/**",
        "node_modules/sharp/**",
        "node_modules/cypress/**",
        "node_modules/@testing-library/**",
        "node_modules/mocha/**",
        "node_modules/chai/**",
        "node_modules/sinon/**"
      ]
    },
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "build": {
    "env": {
      "CI": "false"
    }
  }
}