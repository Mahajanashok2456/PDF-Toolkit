{
  "rewrites": [
    { "source": "/api/pdf-to-word", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/server.js" }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 30,
      "includeFiles": "server-src/**"
    },
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "build": {
    "env": {
      "CI": "false"
    }
  }
}