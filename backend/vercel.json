{
  "version": 2,
  "functions": {
    "api/server.js": { "maxDuration": 30 },
    "api/flask_app.py": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/pdf-to-word", "destination": "/api/flask_app.py" },
    { "source": "/api/(.*)", "destination": "/api/server.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}