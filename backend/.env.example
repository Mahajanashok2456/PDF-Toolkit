# .env.example for Backend (Render)
# Copy this to .env for local development
# On Render, set these in Environment Variables section

# CORS Configuration
# Comma-separated list of allowed origins
# For local development:
ALLOWED_ORIGINS=http://localhost:3000

# For production (update with your actual domains):
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-*.vercel.app

# MongoDB Connection (Optional - for ratings feature)
# Get this from MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pdf-toolkit?retryWrites=true&w=majority

# Server Port (Render sets this automatically)
PORT=3001

# Node Environment
NODE_ENV=development

# Image Processing Settings (Optional)
JPG_TO_PDF_MAX_DIM=2000
JPG_TO_PDF_QUALITY=70
