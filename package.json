{
  "name": "pdf-toolkit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified PDF Toolkit with React Frontend and Node.js/Python Backend",
  "main": "api/server.js",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@sentry/react": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.16",
    "axios": "^1.13.2",
    "cra-template-pwa": "2.0.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.18",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "react-scripts build",
    "build:analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "node server.js",
    "api-test": "mocha api/**/*.test.js --exit",
    "deploy": "vercel --prod",
    "preview": "vercel",
    "postbuild": "echo 'Build completed successfully!'"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.21",
    "chai": "^4.3.10",
    "cypress": "^13.6.0",
    "mocha": "^10.2.0",
    "postcss": "^8.5.6",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.1",
    "supertest": "^6.3.3",
    "vercel": "^32.5.0"
  },
  "overrides": {
    "webpack": "5.88.2"
  },
  "resolutions": {
    "**/webpack": "5.88.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
